# build files from cmake
build/*
# python temporary files
*.pyc
*.py~
*__pycache__/*
*.egg-info/
# editor temporary files
*~
*#
# object and binaries
obj/*
bin/*
# local config
Makefile.conf
#  submodule binary and object files
src/physics/managers/empty/libphy_modules.a
src/physics/managers/empty/obj/*
src/physics/managers/empty/*.o
src/physics/managers/multi/libphy_modules.a
src/physics/managers/multi/obj/*
src/physics/managers/multi/*.o
# output data
results*/
/*_results/
/init/
/venus_long/

# Local installers and environments
/Miniconda3-*-Linux-*.sh

# Generated initial-condition data (keep the reproducible .thr inputs tracked)
/ic_special/*/*.h5
/ic_special/*/config_copy.*
/ifile/*_original.h5
# profiling data
profiling/*
# compile command database
compile_commands.json
# version information generated at compile time
include/git-rev.h
# jupyter notebooks temp checkpoints directories
**/.ipynb_checkpoints/

# Local environment and generated file-conversion products
.venv-fileconversions/
mjolnir/fileconversions/validation/*.grib*
mjolnir/fileconversions/validation/*.grb*
mjolnir/fileconversions/validation/*.nc
mjolnir/fileconversions/validation/*.h5
